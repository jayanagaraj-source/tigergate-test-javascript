# FIX-SEC-020: npm registry auth token committed to source.
//registry.npmjs.org/:_authToken=npm_FIXTUREfixtureFIXTUREfixtureFIXTURE0
# FIX-SCA-030: package integrity / audit checks disabled.
audit=false
strict-ssl=false
# FIX-SCA-032: strict peer-dependency resolution disabled, so known-incompatible
# versions install silently (here: lodash 4.17.15 against @langchain/community's
# peerOptional ^4.17.21). Also what lets the vulnerable pins coexist with the AI stack.
legacy-peer-deps=true
